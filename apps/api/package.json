{
  "name": "@psigest/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/app.test.ts",
    "db:prepare:postgres": "node scripts/prepare-postgres.mjs",
    "db:generate:postgres": "npm run db:prepare:postgres && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:migrate:postgres": "npm run db:prepare:postgres && prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "build:vercel": "npm run db:generate:postgres && npm run typecheck",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  }
}
